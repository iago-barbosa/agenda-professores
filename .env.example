DATABASE_URL="file:./dev.db"

# Chave que criptografa o cookie de login. Precisa ter pelo menos 32 caracteres.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais"

